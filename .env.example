# ====================================================================
# NAWI Compliance & Test Report System - Environment Configuration
# ====================================================================

# Backend Configuration
PROJECT_NAME="NAWI Compliance & Test Report System"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL
# For PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nawi_db
# For Standalone Local Development (zero-dependency SQLite):
# DATABASE_URL=sqlite:///./nawi.db

# Frontend URL / CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Vite Configuration
VITE_API_URL="/api"
