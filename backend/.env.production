# Production Environment Configuration — NAWI System
ENVIRONMENT=production
DEBUG=False
APP_NAME="NAWI Testing & OIML R-76 Legal Metrology Compliance System"
VERSION="1.0.0"

# Database Configuration (SQLite or PostgreSQL)
DATABASE_URL="sqlite:///./nawi.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://nawi_admin:SecurePassword123!@localhost:5432/nawi_prod"

# Security & Cryptography
SECRET_KEY="PRODUCTION_CHANGE_ME_SUPER_SECRET_KEY_MIN_32_BYTES_HEX_STRING"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:8000"]
